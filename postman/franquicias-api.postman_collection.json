    {
      "name": "Productos",
      "item": [
        {
          "name": "Agregar producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Postman\",\n  \"cantidadStock\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/franquicias/{{franquiciaId}}/sucursales/{{sucursalId}}/productos",
            "description": "Agrega un producto y guarda el ultimo productoId devuelto."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const sucursal = (body.sucursales || []).find(function (item) { return item.id === pm.collectionVariables.get('sucursalId'); });",
                  "pm.expect(sucursal, 'Sucursal en respuesta').to.exist;",
                  "pm.expect(sucursal.productos.length).to.be.greaterThan(0);",
                  "const producto = sucursal.productos[sucursal.productos.length - 1];",
                  "pm.collectionVariables.set('productoId', producto.id);",
                  "console.log('productoId:', producto.id);"
                ]
              }
            }
          ]
        },
