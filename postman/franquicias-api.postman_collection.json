            },
            "url": "{{baseUrl}}/franquicias/{{franquiciaId}}/sucursales",
            "description": "Agrega una sucursal y guarda el ultimo sucursalId devuelto."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const sucursales = body.sucursales || [];",
                  "pm.expect(sucursales.length).to.be.greaterThan(0);",
                  "const sucursal = sucursales[sucursales.length - 1];",
                  "pm.collectionVariables.set('sucursalId', sucursal.id);",
                  "console.log('sucursalId:', sucursal.id);"
                ]
              }
            }
          ]
        },
