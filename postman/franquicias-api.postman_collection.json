                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Franquicia Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/franquicias",
            "description": "Crea una franquicia y guarda su ID en la variable de coleccion franquiciaId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.be.a('string');",
                  "pm.collectionVariables.set('franquiciaId', body.id);",
                  "console.log('franquiciaId:', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar nombre de franquicia",
